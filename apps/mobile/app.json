{
  "expo": {
    "name": "Nacho OS",
    "slug": "nacho-os",
    "scheme": "nachoos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "../../resources/icon.png",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios"],
    "ios": {
      "bundleIdentifier": "com.waumann.nachoos.native",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0085c8",
          "image": "./assets/splash-logo.png",
          "imageWidth": 400
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
